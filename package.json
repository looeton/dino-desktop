{
  "name": "dino-desktop",
  "version": "1.0.0",
  "description": "Chrome 离线恐龙跑酷游戏的跨平台桌面复刻版 / Offline T-Rex Runner game as a cross-platform desktop app",
  "main": "main.js",
  "author": "looeton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looeton/dino-desktop.git"
  },
  "keywords": [
    "electron",
    "dinosaur-game",
    "t-rex-runner",
    "chrome-dino",
    "game"
  ],
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.looeton.dino",
    "productName": "Dino Runner",
    "copyright": "Copyright © 2026 looeton",
    "asar": true,
    "asarUnpack": [
      "preload.js"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "looeton",
        "repo": "dino-desktop"
      }
    ]
  }
}
